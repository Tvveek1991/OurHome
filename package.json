{
  "name": "our-home-organizer",
  "version": "0.2.0",
  "description": "Уютный семейный органайзер для Windows",
  "author": "Наш дом",
  "main": "electron-main.cjs",
  "private": true,
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nashdom.organizer",
    "productName": "Наш дом",
    "directories": {
      "output": "../../outputs/our-home-windows"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
